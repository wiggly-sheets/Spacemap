<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Kept: Sparkle's updater XPC service loads outside the main bundle, so
         library validation must stay off or updates silently fail to launch.
         Everything else was removed (unsigned-executable-memory, dyld env)
         — re-add only with a documented need. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
